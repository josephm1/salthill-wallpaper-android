<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceHeadlineLarge" android:layout_marginTop="8dp" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tagline" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp" android:layout_marginBottom="20dp" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="174dp" android:layout_marginBottom="16dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/coast_preview" android:scaleType="centerCrop" android:importantForAccessibility="no" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70102136" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:padding="20dp">
                        <TextClock android:id="@+id/local_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="@string/clock_format" android:format12Hour="@string/clock_format_12" android:textColor="#FFFFFF" android:textSize="36sp" android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/clock_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/local_time" android:textColor="#FFFFFF" android:textAppearance="?attr/textAppearanceLabelMedium" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/weather_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="20dp" android:textColor="#FFFFFF" android:textAppearance="?attr/textAppearanceTitleMedium" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weather_location" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_marginBottom="14dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/location_choices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/location_current" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/my_location" app:icon="@drawable/ic_location" app:iconGravity="textStart" android:paddingStart="8dp" android:paddingEnd="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/location_salthill" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/salthill" app:icon="@drawable/ic_place" app:iconGravity="textStart" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/location_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/location_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/tide_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorPrimary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/location_refresh" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/update_location" app:icon="@drawable/ic_location" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/movement" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_marginBottom="12dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/motion_choices" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/motion_economy" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/economy" android:paddingStart="4dp" android:paddingEnd="4dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/motion_balanced" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/balanced" android:paddingStart="4dp" android:paddingEnd="4dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/motion_smooth" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/smooth" android:paddingStart="4dp" android:paddingEnd="4dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/motion_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/set_wallpaper" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/wallpaper_action" app:icon="@drawable/ic_wallpaper" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/preview_scene" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/preview_action" app:icon="@drawable/ic_play" app:iconGravity="textStart" android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/set_screensaver" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/screensaver_action" app:icon="@drawable/ic_moon" app:iconGravity="textStart" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/forecast_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" android:paddingTop="12dp" android:paddingBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/advanced_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/advanced" app:icon="@drawable/ic_expand" app:iconGravity="textEnd" />
            <LinearLayout android:id="@+id/advanced_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tide_input" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tide_url" app:helperText="@string/tide_help">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/tide_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/save_tide" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_tide" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/attribution" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/weather_attribution" android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
